-- V19__create_assessment_session_tables.sql

-- 1. Assessments Table
CREATE TABLE IF NOT EXISTS assessments (
    id BIGSERIAL PRIMARY KEY,
    title VARCHAR(255) NOT NULL,
    description TEXT,
    assessment_type VARCHAR(32) NOT NULL,
    duration_minutes INT NOT NULL CHECK (duration_minutes > 0),
    total_points INT NOT NULL DEFAULT 0,
    passing_score NUMERIC(5, 2) NOT NULL DEFAULT 60.00 CHECK (passing_score >= 0 AND passing_score <= 100),
    active BOOLEAN NOT NULL DEFAULT true,
    created_at TIMESTAMP WITH TIME ZONE NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP WITH TIME ZONE NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- 2. Assessment Problems (Join table preserving ordering and custom point weighting)
CREATE TABLE IF NOT EXISTS assessment_problems (
    id BIGSERIAL PRIMARY KEY,
    assessment_id BIGINT NOT NULL REFERENCES assessments(id) ON DELETE CASCADE,
    problem_id BIGINT NOT NULL REFERENCES problems(id) ON DELETE RESTRICT,
    display_order INT NOT NULL CHECK (display_order > 0),
    points INT NOT NULL CHECK (points > 0),
    required BOOLEAN NOT NULL DEFAULT true,
    created_at TIMESTAMP WITH TIME ZONE NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT uk_assessment_problem UNIQUE (assessment_id, problem_id),
    CONSTRAINT uk_assessment_order UNIQUE (assessment_id, display_order)
);

-- 3. Assessment Sessions (Represents a user's timed attempt)
CREATE TABLE IF NOT EXISTS assessment_sessions (
    id BIGSERIAL PRIMARY KEY,
    assessment_id BIGINT NOT NULL REFERENCES assessments(id) ON DELETE RESTRICT,
    user_id BIGINT NOT NULL REFERENCES users(id) ON DELETE RESTRICT,
    status VARCHAR(32) NOT NULL DEFAULT 'IN_PROGRESS',
    started_at TIMESTAMP WITH TIME ZONE NOT NULL,
    expires_at TIMESTAMP WITH TIME ZONE NOT NULL,
    submitted_at TIMESTAMP WITH TIME ZONE,
    last_activity_at TIMESTAMP WITH TIME ZONE NOT NULL,
    total_score NUMERIC(6, 2) DEFAULT 0.0,
    percentage NUMERIC(5, 2) DEFAULT 0.0,
    passed BOOLEAN DEFAULT false,
    current_problem_id BIGINT REFERENCES problems(id),
    created_at TIMESTAMP WITH TIME ZONE NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP WITH TIME ZONE NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- 4. Assessment Session Problems (Tracks per-problem progress and saved code drafts)
CREATE TABLE IF NOT EXISTS assessment_session_problems (
    id BIGSERIAL PRIMARY KEY,
    session_id BIGINT NOT NULL REFERENCES assessment_sessions(id) ON DELETE CASCADE,
    assessment_problem_id BIGINT NOT NULL REFERENCES assessment_problems(id) ON DELETE CASCADE,
    status VARCHAR(32) NOT NULL DEFAULT 'NOT_STARTED',
    started_at TIMESTAMP WITH TIME ZONE,
    completed_at TIMESTAMP WITH TIME ZONE,
    best_submission_id BIGINT REFERENCES submissions(id) ON DELETE SET NULL,
    score NUMERIC(6, 2) DEFAULT 0.0,
    attempt_count INT NOT NULL DEFAULT 0,
    last_saved_code TEXT,
    last_saved_language VARCHAR(32),
    updated_at TIMESTAMP WITH TIME ZONE NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT uk_session_assessment_problem UNIQUE (session_id, assessment_problem_id)
);

-- 5. Optional Link to Submissions (Link assessment submissions to sessions)
DO $$
BEGIN
    IF NOT EXISTS (
        SELECT 1 FROM information_schema.columns
        WHERE table_name = 'submissions' AND column_name = 'assessment_session_id'
    ) THEN
        ALTER TABLE submissions ADD COLUMN assessment_session_id BIGINT REFERENCES assessment_sessions(id) ON DELETE SET NULL;
        CREATE INDEX idx_submissions_assessment_session_id ON submissions(assessment_session_id);
    END IF;
END $$;

-- 6. Indexes for High-Traffic Queries & Expiry Lookups
CREATE INDEX idx_assessments_active ON assessments(active);
CREATE INDEX idx_assessment_problems_assessment_id ON assessment_problems(assessment_id);
CREATE INDEX idx_assessment_problems_problem_id ON assessment_problems(problem_id);

CREATE INDEX idx_assessment_sessions_user_id ON assessment_sessions(user_id);
CREATE INDEX idx_assessment_sessions_assessment_id ON assessment_sessions(assessment_id);
CREATE INDEX idx_assessment_sessions_status ON assessment_sessions(status);
CREATE INDEX idx_assessment_sessions_expires_at ON assessment_sessions(expires_at);
CREATE INDEX idx_assessment_sessions_user_status ON assessment_sessions(user_id, status);

CREATE INDEX idx_session_problems_session_id ON assessment_session_problems(session_id);
CREATE INDEX idx_session_problems_assessment_prob_id ON assessment_session_problems(assessment_problem_id);