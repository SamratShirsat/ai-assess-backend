-- V20__add_admin_dashboard_indexes.sql

-- User lookups and role aggregations
CREATE INDEX IF NOT EXISTS idx_users_role ON users(role);
CREATE INDEX IF NOT EXISTS idx_users_created_at ON users(created_at DESC);

-- Problem aggregations
CREATE INDEX IF NOT EXISTS idx_problems_difficulty ON problems(difficulty);
CREATE INDEX IF NOT EXISTS idx_problems_topic ON problems(topic);

-- Submission monitoring and activity timelines
CREATE INDEX IF NOT EXISTS idx_submissions_status ON submissions(status);
CREATE INDEX IF NOT EXISTS idx_submissions_submitted_at ON submissions(submitted_at DESC);
CREATE INDEX IF NOT EXISTS idx_submissions_user_problem ON submissions(user_id, problem_id);

-- Assessment monitoring
CREATE INDEX IF NOT EXISTS idx_assessments_type ON assessments(assessment_type);
CREATE INDEX IF NOT EXISTS idx_assessment_sessions_submitted_at ON assessment_sessions(submitted_at DESC);

-- Similarity review status
CREATE INDEX IF NOT EXISTS idx_code_similarity_status ON code_similarity_results(status);
CREATE INDEX IF NOT EXISTS idx_code_similarity_level ON code_similarity_results(similarity_level);